APP_NAME="HFL Logistics API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Phnom_Penh

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hfl_logistics
DB_USERNAME=root
DB_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# China warehouse/package API integration
CHINA_PACKAGE_API_URL=
CHINA_PACKAGE_API_TOKEN=
CHINA_PACKAGE_API_TIMEOUT=30


# API mode: mock for development/testing, real for the China team's production API
CHINA_API_MODE=mock

# Yangcheng / 海发物流 API
CHINA_API_URL=https://ycserver.zq-zn.com
CHINA_API_ENDPOINT=/api/WayBill/QueryWayBillSpeed
CHINA_API_TOKEN=
CHINA_API_TIMEOUT=60
CHINA_API_PAGE_SIZE=100
CHINA_API_MAX_PAGES=500
CHINA_API_FORM_NO=ty-sy
CHINA_API_STOCK_ID=1
CHINA_API_DATE_RANGE=
# Base URL used to complete relative product-image paths from the China API
# (leave empty to reuse CHINA_API_URL).
CHINA_API_IMAGE_BASE=

# ---- FAKE China API for testing (no second server needed) ----
# Set CHINA_API_MODE=mock above, keep APP_URL equal to the address that serves the backend
# (e.g. http://127.0.0.1:8000), run `php artisan config:clear`, then press Sync China.
# It returns 30 fake waybills with product photos. Remove them later with:
#   php artisan china:mock-clean
# When the real China API is ready: CHINA_API_MODE=real and fill CHINA_API_URL / CHINA_API_TOKEN.
CHINA_MOCK_TOKEN=mock-token
CHINA_DEFAULT_CONTAINER_TYPE=40HQ
CHINA_DEFAULT_SHIPPING_MODE=SEA
CHINA_DEFAULT_ORIGIN=China
CHINA_DEFAULT_DESTINATION=Cambodia
CHINA_DEFAULT_LOCATION="China Warehouse"
CHINA_DEFAULT_CONTAINER_STATUS=Loading
