{
  "name": "hfl/logistics-backend",
  "type": "project",
  "require": {
    "php": "^8.4",
    "ext-intl": "*",
    "laravel/framework": "^12.0",
    "laravel/sanctum": "^4.0",
    "phpoffice/phpspreadsheet": "^5.10"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.18",
    "phpunit/phpunit": "^11.0",
    "laravel/tinker": "^3.0",
    "mockery/mockery": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/",
      "Database\\Factories\\": "database/factories/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
