    // --------------------------------------------------------
    // SHOW INVOICE WITH PAYMENT HISTORY
    // --------------------------------------------------------

    public function show($id)
    {
        $invoice = Invoice::where('is_test', false)
            ->findOrFail($id);

        $payments = Payment::where('is_test', false)
            ->where('invoice_id', $invoice->id)
            ->orderByDesc('paid_at')
            ->get();

        // Display current package information without
        // changing stored invoice amounts.
        $items = is_array($invoice->items)
            ? $invoice->items
            : [];

        $displayItems = collect($items)->map(
            function ($item) {
                if (
                    !is_array($item)
                    || strtolower(
                        (string) ($item['type'] ?? '')
                    ) !== 'shipping'
                ) {
                    return $item;
                }

                $packageId = $item['package_id'] ?? null;

                $package = $packageId !== null
                    ? Package::find($packageId)
                    : null;

                if (!$package) {
                    return $item;
                }

                $productName = trim((string) (
                    $package->product_name
                    ?: $package->product_category
                    ?: 'Logistics Service'
                ));

                $boxCount = (int) (
                    $package->box_count ?? 0
                );

                $itemQuantity = (int) (
                    $package->quantity ?? 0
                );

                $item['product_name'] = $productName;

                $item['package_number'] =
                    $package->package_id
                    ?: ($item['package_number'] ?? null);

                $item['china_waybill_number'] =
                    $package->china_waybill_number
                    ?: (
                        $package->tracking_number
                        ?: (
                            $item['china_waybill_number']
                            ?? null
                        )
                    );

                $item['tracking_number'] =
                    $package->tracking_number
                    ?: ($item['tracking_number'] ?? null);

                $item['hfl_package_code'] =
                    $package->hfl_package_code
                    ?: ($item['hfl_package_code'] ?? null);

                $item['quantity'] = max(
                    1,
                    $boxCount > 0
                        ? $boxCount
                        : $itemQuantity
                );

                return $item;
            }
        )->values()->all();

        $invoice->setAttribute(
            'items',
            $displayItems
        );

        $invoice->setAttribute(
            'payments',
            $payments
        );

        return $this->ok(
            $invoice,
            'Invoice retrieved'
        );
    }

    // --------------------------------------------------------
    // UPDATE BILLING SNAPSHOT
    // --------------------------------------------------------

    public function updateBilling(Request $request, $id)
    {
        $data = $request->validate([
            'final_cbm' => 'required|numeric|min:0',
            'final_weight' => 'nullable|numeric|min:0',
            'pricing_type' => 'nullable|in:GC,SC',
            'rate' => 'required|numeric|min:0.0001',
            'delivery_fee' => 'nullable|numeric|min:0',
            'handling_fee' => 'nullable|numeric|min:0',
            'warehouse_fee' => 'nullable|numeric|min:0',
            'other_fee' => 'nullable|numeric|min:0',
            'local_delivery_fee' => 'nullable|numeric|min:0',
            'china_tax_refund_fee' => 'nullable|numeric|min:0',
            'cambodia_crane_fee' => 'nullable|numeric|min:0',
            'china_pickup_fee' => 'nullable|numeric|min:0',
            'wood_crating_fee' => 'nullable|numeric|min:0',
            'discount' => 'nullable|numeric|min:0',
            'due_date' => 'nullable|date',
        ]);

        return DB::transaction(function () use ($data, $id) {
            $invoice = Invoice::where('is_test', false)
                ->lockForUpdate()
                ->findOrFail($id);

            if ($this->isVoided($invoice->status)) {
                return $this->fail(
                    'Cancelled or void invoices cannot be edited.',
                    [],
                    422
                );
            }

            $items = is_array($invoice->items)
                ? $invoice->items
                : [];

            $shippingIndex = collect($items)->search(
                fn ($item) =>
                    is_array($item)
                    && strtolower(
                        (string) ($item['type'] ?? '')
                    ) === 'shipping'
            );

            if ($shippingIndex === false) {
                return $this->fail(
                    'This invoice is not linked to a shipping '
                    . 'package and cannot use package billing edit mode.',
                    [],
                    422
                );
            }

            $shippingItem = $items[$shippingIndex];

            $packageId =
                $shippingItem['package_id'] ?? null;

            $package = $packageId
                ? Package::find($packageId)
                : null;

            $snapshot = is_array(
                $invoice->pricing_snapshot
            )
                ? $invoice->pricing_snapshot
                : [];

            $meta = is_array($invoice->meta)
                ? $invoice->meta
                : [];

            $finalCbm = (float) $data['final_cbm'];

            $finalWeight = (
                array_key_exists('final_weight', $data)
                && $data['final_weight'] !== null
            )
                ? (float) $data['final_weight']
                : (float) (
                    $snapshot['final_weight']
                    ?? $meta['final_weight']
                    ?? 0
                );

            $pricingType = strtoupper((string) (
                $data['pricing_type']
                ?? $snapshot['pricing_type']
                ?? $meta['pricing_type']
                ?? 'GC'
            ));

            $rate = (float) $data['rate'];

            $rateType = strtoupper((string) (
                $snapshot['rate_type'] ?? 'CBM'
            ));

            $minimumCbm = (float) (
                $snapshot['minimum_cbm'] ?? 0
            );

            $chargeable = $rateType === 'KG'
                ? $finalWeight
                : max($finalCbm, $minimumCbm);

            $shippingCost = round(
                $chargeable * $rate,
                2
            );

            $deliveryFee = (float) (
                $data['delivery_fee'] ?? 0
            );

            $handlingFee = (float) (
                $data['handling_fee'] ?? 0
            );

            $warehouseFee = (float) (
                $data['warehouse_fee'] ?? 0
            );

            $otherFee = (float) (
                $data['other_fee'] ?? 0
            );

            $newFees = [
                'local_delivery_fee' => (float) (
                    $data['local_delivery_fee']
                    ?? $snapshot['local_delivery_fee']
                    ?? $meta['local_delivery_fee']
                    ?? 0
                ),
                'china_tax_refund_fee' => (float) (
                    $data['china_tax_refund_fee']
                    ?? $snapshot['china_tax_refund_fee']
                    ?? $meta['china_tax_refund_fee']
                    ?? 0
                ),
                'cambodia_crane_fee' => (float) (
                    $data['cambodia_crane_fee']
                    ?? $snapshot['cambodia_crane_fee']
                    ?? $meta['cambodia_crane_fee']
                    ?? 0
                ),
                'china_pickup_fee' => (float) (
                    $data['china_pickup_fee']
                    ?? $snapshot['china_pickup_fee']
                    ?? $meta['china_pickup_fee']
                    ?? 0
                ),
                'wood_crating_fee' => (float) (
                    $data['wood_crating_fee']
                    ?? $snapshot['wood_crating_fee']
                    ?? $meta['wood_crating_fee']
                    ?? 0
                ),
            ];

            $newFeesTotal = array_sum($newFees);

            $discount = (float) (
                $data['discount'] ?? 0
            );

            $feeSubtotal =
                $deliveryFee
                + $handlingFee
                + $warehouseFee
                + $newFeesTotal;

            $discount = min(
                $feeSubtotal + $shippingCost + $otherFee,
                $discount
            );

            $grandTotal = round(
                max(
                    0,
                    $feeSubtotal
                    + $shippingCost
                    + $otherFee
                    - $discount
                ),
                2
            );

            $paidAmount = round(
                (float) ($invoice->paid_amount ?? 0),
                2
            );

            if ($grandTotal + 0.0001 < $paidAmount) {
                return $this->fail(
                    'The new bill total cannot be lower '
                    . 'than the amount already paid. '
                    . 'Reduce or refund the payment first.',
                    [
                        'grand_total' => [
                            'New total must be at least '
                            . number_format(
                                $paidAmount,
                                2,
                                '.',
                                ''
                            ),
                        ],
                    ],
                    422
                );
            }

            $outstanding = round(
                max(0, $grandTotal - $paidAmount),
                2
            );

            $status = $outstanding <= 0.0001
                ? 'Paid'
                : (
                    $paidAmount > 0
                        ? 'Partially Paid'
                        : 'Unpaid'
                );

            $shippingItem['cbm'] = $finalCbm;
            $shippingItem['weight'] = $finalWeight;

            $boxCount = (int) (
                $package?->box_count ?? 0
            );

            $itemQuantity = (int) (
                $package?->quantity ?? 0
            );

            $shippingItem['quantity'] = max(
                1,
                $boxCount > 0
                    ? $boxCount
                    : (
                        $itemQuantity > 0
                            ? $itemQuantity
                            : (int) (
                                $shippingItem['quantity']
                                ?? 1
                            )
                    )
            );

            if ($package) {
                $shippingItem['description'] = trim(
                    (string) (
                        $package->product_name
                        ?: $package->product_category
                        ?: (
                            $shippingItem['description']
                            ?? 'Logistics Service'
                        )
                    )
                );
            }

            $shippingItem['unit_price'] = $rate;
            $shippingItem['amount'] = $shippingCost;

            $items[$shippingIndex] = $shippingItem;

            // Remove generated fee lines and rebuild.
            $items = array_values(
                array_filter(
                    $items,
                    function ($item) {
                        return strtolower(
                            (string) ($item['type'] ?? '')
                        ) !== 'fee';
                    }
                )
            );

            if ($package) {
                foreach ([
                    ['Delivery Fee', $deliveryFee],
                    ['Handling Fee', $handlingFee],
                    ['Warehouse Fee', $warehouseFee],
                    ['Other Fee', $otherFee],
                    ['Local Delivery Fee', $newFees['local_delivery_fee']],
                    ['China Tax Refund Fee', $newFees['china_tax_refund_fee']],
                    ['Cambodia Crane Fee', $newFees['cambodia_crane_fee']],
                    ['China Pickup Fee', $newFees['china_pickup_fee']],
                    ['Wood Crating Fee', $newFees['wood_crating_fee']],
                ] as [$label, $amount]) {
                    if ($amount > 0) {
                        $items[] = $this->feeItem(
                            $package,
                            $label,
                            $amount,
                            $finalCbm,
                            $finalWeight
                        );
                    }
                }
            }

            // Shipping line first.
            $nonShipping = array_values(
                array_filter(
                    $items,
                    fn ($item) =>
                        strtolower(
                            (string) ($item['type'] ?? '')
                        ) !== 'shipping'
                )
            );

            $items = array_merge(
                [$shippingItem],
                $nonShipping
            );

            $snapshot['pricing_type'] = $pricingType;
            $snapshot['rate'] = $rate;
            $snapshot['rate_type'] = $rateType;
            $snapshot['chargeable'] = $chargeable;
            $snapshot['final_cbm'] = $finalCbm;
            $snapshot['final_weight'] = $finalWeight;
            $snapshot['shipping_cost'] = $shippingCost;
            $snapshot['delivery_fee'] = $deliveryFee;
            $snapshot['handling_fee'] = $handlingFee;
            $snapshot['warehouse_fee'] = $warehouseFee;
            $snapshot['other_fee'] = $otherFee;
            $snapshot['discount'] = $discount;

            $meta['final_cbm'] = $finalCbm;
            $meta['final_weight'] = $finalWeight;
            $meta['pricing_type'] = $pricingType;
            $meta['rate'] = $rate;
            $meta['rate_type'] = $rateType;
            $meta['shipping_cost'] = $shippingCost;
            $meta['delivery_fee'] = $deliveryFee;
            $meta['handling_fee'] = $handlingFee;
            $meta['warehouse_fee'] = $warehouseFee;
            $meta['other_fee'] = $otherFee;
            $meta['discount'] = $discount;

            // Save additional fees in existing JSON fields.
            foreach ($newFees as $feeKey => $feeAmount) {
                $snapshot[$feeKey] = $feeAmount;
                $meta[$feeKey] = $feeAmount;
            }

            $invoice->items = $items;
            $invoice->pricing_snapshot = $snapshot;
            $invoice->meta = $meta;
            $invoice->subtotal = round(
                $feeSubtotal,
                2
            );
            $invoice->discount = round($discount, 2);
            $invoice->tax = 0;
            $invoice->grand_total = $grandTotal;
            $invoice->paid_amount = $paidAmount;
            $invoice->outstanding = $outstanding;
            $invoice->status = $status;

            if (!empty($data['due_date'])) {
                $invoice->due_date = $data['due_date'];
            }

            $invoice->save();

            if ($package) {
                $package->total_cbm = $finalCbm;
                $package->total_weight = $finalWeight;
                $package->pricing_type = $pricingType;
                $package->pricing_rate_type = $rateType;
                $package->shipping_rate = $rate;
                $package->shipping_cost = $shippingCost;
                $package->delivery_fee = $deliveryFee;
                $package->handling_fee = $handlingFee;
                $package->warehouse_fee = $warehouseFee;
                $package->other_fee = $otherFee;
                $package->discount = $discount;
                $package->grand_total = $grandTotal;

                if (in_array(
                    (string) $package->status,
                    [
                        'Measurement Completed',
                        'Ready for Billing',
                        'Cambodia Warehouse',
                    ],
                    true
                )) {
                    $package->status = 'Invoiced';

                    TrackingEvent::create([
                        'tracking_number' =>
                            $package->tracking_number,
                        'package_id' => $package->id,
                        'status' => 'Invoiced',
                        'location' =>
                            $package->warehouse_location
                            ?: 'Cambodia Warehouse',
                        'warehouse' =>
                            'Cambodia Warehouse',
                        'staff_name' =>
                            auth()->user()?->name
                            ?? 'Billing',
                        'note' =>
                            'Current logistics rate confirmed; '
                            . 'billing draft finalized',
                        'event_at' => now(),
                    ]);
                }

                $package->save();
            }

            $invoice = $invoice->fresh();

            $invoice->setAttribute(
                'payments',
                Payment::where('is_test', false)
                    ->where('invoice_id', $invoice->id)
                    ->orderByDesc('paid_at')
                    ->get()
            );

            return $this->ok(
                $invoice,
                'Billing updated'
            );
        });
    }

    // --------------------------------------------------------
    // CREATE MANUAL INVOICE
    // --------------------------------------------------------

    public function store(Request $request)
    {
        $data = $request->validate($this->rules);

        $invoice = DB::transaction(function () use ($data) {
            $items = collect($data['items']);

            $shippingFee = round(
                $items
                    ->filter(
                        fn ($item) =>
                            ($item['type'] ?? '')
                            === 'shipping'
                    )
                    ->sum(
                        fn ($item) =>
                            (float) ($item['amount'] ?? 0)
                    ),
                2
            );

            $otherFee = round(
                $items
                    ->filter(function ($item) {
                        $type = strtolower(
                            (string) ($item['type'] ?? '')
                        );

                        $description = strtolower(
                            (string) (
                                $item['description'] ?? ''
                            )
                        );

                        return $type === 'other_fee'
                            || $description === 'other fee';
                    })
                    ->sum(
                        fn ($item) =>
                            (float) ($item['amount'] ?? 0)
                    ),
                2
            );

            $subtotal = round(
                $items
                    ->reject(function ($item) {
                        return (
                            $item['type'] ?? ''
                        ) === 'shipping'
                            || strtolower(
                                (string) (
                                    $item['description'] ?? ''
                                )
                            ) === 'other fee';
                    })
                    ->sum(
                        fn ($item) =>
                            (float) ($item['amount'] ?? 0)
                    ),
                2
            );

            $discount = min(
                $subtotal + $shippingFee + $otherFee,
                (float) ($data['discount'] ?? 0)
            );

            $grandTotal = round(
                max(
                    0,
                    $subtotal
                    + $shippingFee
                    + $otherFee
                    - $discount
                ),
                2
            );

            $meta = $data['meta'] ?? [];

            $meta['bill_date'] =
                $meta['bill_date']
                ?? now()->toDateString();

            $meta['shipping_fee'] = $shippingFee;
            $meta['other_fee'] = $otherFee;

            $invoice = new Invoice();

            $invoice->invoice_no =
                'TMP-INV-' . Str::uuid();

            $invoice->quotation_id =
                $data['quotation_id'] ?? null;

            $invoice->customer_id =
                $data['customer_id'];

            $invoice->customer_name =
                $data['customer_name'] ?? null;

            $invoice->items = $data['items'];
            $invoice->discount = $discount;
            $invoice->tax = 0;
            $invoice->subtotal = $subtotal;
            $invoice->grand_total = $grandTotal;
            $invoice->paid_amount = 0;
            $invoice->outstanding = $grandTotal;
            $invoice->status = 'Unpaid';

            $invoice->due_date =
                $data['due_date']
                ?? now()->addDays(7)->toDateString();

            $invoice->meta = $meta;

            $invoice->save();

            $invoice->invoice_no =
                $this->finalizeInvoiceNumber(
                    $invoice->id
                );

            $invoice->save();

            return $invoice->fresh();
        });

        return $this->ok(
            $invoice,
            'Created'
        );
    }

    // --------------------------------------------------------
    // GENERATE INVOICE FROM ONE PACKAGE
    // --------------------------------------------------------

    public function fromPackage(Request $request, $packageId)
    {
        $billing = $request->validate([
            'final_cbm' => 'nullable|numeric|min:0',
            'final_weight' => 'nullable|numeric|min:0',
            'pricing_type' => 'nullable|in:GC,SC',
            'rate' => 'nullable|numeric|min:0',
            'delivery_fee' => 'nullable|numeric|min:0',
            'handling_fee' => 'nullable|numeric|min:0',
            'warehouse_fee' => 'nullable|numeric|min:0',
            'other_fee' => 'nullable|numeric|min:0',
            'discount' => 'nullable|numeric|min:0',
            'due_date' => 'nullable|date',
        ]);

        return DB::transaction(function () use (
            $request,
            $packageId,
            $billing
        ) {
            // 1. Find package.
            $package = Package::with([
                'customer',
                'containers.shipment',
            ])
                ->where(function ($query) use ($packageId) {
                    $query
                        ->where('id', $packageId)
                        ->orWhere('package_id', $packageId)
                        ->orWhere(
                            'hfl_package_code',
                            $packageId
                        )
                        ->orWhere(
                            'tracking_number',
                            $packageId
                        )
                        ->orWhere(
                            'china_waybill_number',
                            $packageId
                        );
                })
                ->firstOrFail();

            // 2. Prevent duplicate ACTIVE invoice.
            // Void invoices do not block new billing.
            $existingInvoice = Invoice::query()
                ->where('is_test', false)
                ->whereNotIn('status', [
                    'Void',
                    'Voided',
                    'Cancelled',
                ])
                ->get()
                ->first(function ($invoice) use ($package) {
                    $items = is_array($invoice->items)
                        ? $invoice->items
                        : [];

                    return collect($items)->contains(
                        fn ($item) =>
                            is_array($item)
                            && (string) (
                                $item['package_id'] ?? ''
                            ) === (string) $package->id
                    );
                });

            if ($existingInvoice) {
                if (!in_array(
                    (string) $package->status,
                    [
                        'Delivered',
                        'Cancelled',
                        'Returned',
                        'Invoiced',
                        'Partially Paid',
                        'Ready for Delivery',
                    ],
                    true
                )) {
                    $package->status = 'Invoiced';
                    $package->save();

                    TrackingEvent::create([
                        'tracking_number' =>
                            $package->tracking_number,
                        'package_id' => $package->id,
                        'status' => 'Invoiced',
                        'location' =>
                            $package->warehouse_location
                            ?: 'Cambodia Warehouse',
                        'warehouse' =>
                            'Cambodia Warehouse',
                        'staff_name' =>
                            auth()->user()?->name
                            ?? 'Billing',
                        'note' =>
                            'Existing invoice linked to package',
                        'event_at' => now(),
                    ]);
                }

                $existingInvoice->setAttribute(
                    'payments',
                    Payment::where('is_test', false)
                        ->where(
                            'invoice_id',
                            $existingInvoice->id
                        )
                        ->orderByDesc('paid_at')
                        ->get()
                );

                return $this->ok(
                    $existingInvoice,
                    'Package already has an invoice.'
                );
            }

            // 3. Determine effective warehouse status.
            $containerForBilling = $package->containers
                ->sortByDesc(
                    fn ($container) =>
                        optional(
                            $container->trackingEvents->first()
                        )->event_date
                        ?? $container->updated_at
                )
                ->first();

            $effectiveBillingStatus =
                (string) ($package->status ?? '');

            if ($containerForBilling) {
                $containerStatus = (string) (
                    $containerForBilling->status ?? ''
                );

                if (in_array(
                    $containerStatus,
                    ['Cambodia Warehouse', 'Received'],
                    true
                )) {
                    $effectiveBillingStatus =
                        'Cambodia Warehouse';
                } elseif (
                    $containerStatus === 'Delivered'
                    && $effectiveBillingStatus === 'Loading'
                ) {
                    $effectiveBillingStatus =
                        'Cambodia Warehouse';
                }
            }

            // 4. Prepare package measurement and pricing.
            if (in_array(
                $effectiveBillingStatus,
                [
                    'Cambodia Warehouse',
                    'Measurement Completed',
                ],
                true
            )) {
                if (
                    (float) $package->total_cbm <= 0
                    && (float) $package->total_weight <= 0
                ) {
                    return $this->fail(
                        'Please complete the Cambodia Warehouse '
                        . 'measurement first. CBM or weight is required.',
                        [
                            'status' => [
                                'Current package status: '
                                . (
                                    $package->status
                                    ?: 'Unknown'
                                ),
                            ],
                        ],
                        422
                    );
                }

                $pricingResolver = app(
                    PackageController::class
                );

                $activePricing =
                    $pricingResolver->findActivePricingForPackage(
                        strtoupper(
                            (string) $package->shipping_mode
                        ),
                        strtoupper(
                            (string) $package->pricing_type
                        ),
                        trim(
                            (string) $package->from_warehouse
                        ),
                        trim(
                            (string) $package->to_warehouse
                        )
                    );

                if ($activePricing) {
                    $package =
                        $pricingResolver->recalculatePricing(
                            $package
                        );
                }
            }

            if (!in_array(
                $effectiveBillingStatus,
                [
                    'Cambodia Warehouse',
                    'Measurement Completed',
                    'Ready for Billing',
                ],
                true
            )) {
                return $this->fail(
                    'Package cannot be billed from its '
                    . 'current status: '
                    . (
                        $package->status
                        ?: 'Unknown'
                    )
                    . '.',
                    [
                        'status' => [
                            'Only a package that is Ready for '
                            . 'Billing can create an invoice.',
                        ],
                    ],
                    422
                );
            }

            // 5. Resolve customer, container and shipment.
            $customer = $package->customer
                ?: Customer::where(
                    'customer_id',
                    $package->customer_id
                )->first();

            $container = $package->containers->first();

            $shipment = $container?->shipment;

            if (!$shipment) {
                $shipment = Shipment::query()
                    ->get()
                    ->first(function ($candidate) use ($package) {
                        $ids = is_array(
                            $candidate->package_ids
                        )
                            ? $candidate->package_ids
                            : (
                                json_decode(
                                    (string) $candidate->package_ids,
                                    true
                                ) ?: []
                            );

                        return collect($ids)
                            ->map(
                                fn ($value) =>
                                    (string) $value
                            )
                            ->contains(
                                (string) $package->id
                            );
                    });
            }

            // 6. Final measurement.
            $finalCbm = (
                array_key_exists('final_cbm', $billing)
                && $billing['final_cbm'] !== null
            )
                ? (float) $billing['final_cbm']
                : (float) (
                    $package->total_cbm ?? 0
                );

            $finalWeight = (
                array_key_exists('final_weight', $billing)
                && $billing['final_weight'] !== null
            )
                ? (float) $billing['final_weight']
                : (float) (
                    $package->total_weight ?? 0
                );

            $pricingType = strtoupper(
                (string) (
                    $billing['pricing_type']
                    ?? $package->pricing_type
                    ?? 'GC'
                )
            );

            $shippingMode = strtoupper(
                (string) (
                    $shipment?->shipping_mode
                    ?: $package->shipping_mode
                    ?: 'LAND'
                )
            );

            $origin = (string) (
                $shipment?->origin
                ?: $package->from_warehouse
                ?: ''
            );

            $destination = (string) (
                $shipment?->destination
                ?: $package->to_warehouse
                ?: ''
            );

            // 7. Find active pricing.
            $pricing = null;

            if ($origin !== '' && $destination !== '') {
                $today = now()->toDateString();

                $pricing = Pricing::query()
                    ->where(
                        'shipping_mode',
                        $shippingMode
                    )
                    ->where(
                        'pricing_type',
                        $pricingType
                    )
                    ->where('origin', $origin)
                    ->where('destination', $destination)
                    ->where('status', 'Active')
                    ->where(function ($query) use ($today) {
                        $query
                            ->whereNull('effective_date')
                            ->orWhereDate(
                                'effective_date',
                                '<=',
                                $today
                            );
                    })
                    ->where(function ($query) use ($today) {
                        $query
                            ->whereNull('expiry_date')
                            ->orWhereDate(
                                'expiry_date',
                                '>=',
                                $today
                            );
                    })
                    ->orderByDesc('effective_date')
                    ->first();
            }

            // 8. Pricing snapshot.
            $pricingSnapshot = null;
            $rateType = 'CBM';
            $minimumCbm = 0;
            $rate = null;
            $pricingId = $package->pricing_id;

            if ($pricing) {
                $pricingId = $pricing->pricing_id;

                $rateType = strtoupper(
                    (string) (
                        $pricing->rate_type ?: 'CBM'
                    )
                );

                $minimumCbm = (float) (
                    $pricing->minimum_cbm ?? 0
                );

                $rate = (float) $pricing->rate;

                $pricingSnapshot = [
                    'pricing_id' =>
                        $pricing->pricing_id,
                    'rate_name' =>
                        $pricing->rate_name,
                    'shipping_mode' =>
                        $pricing->shipping_mode,
                    'pricing_type' =>
                        $pricingType,
                    'origin' =>
                        $pricing->origin,
                    'destination' =>
                        $pricing->destination,
                    'rate_type' =>
                        $rateType,
                    'rate' =>
                        $rate,
                    'minimum_cbm' =>
                        $minimumCbm,
                    'currency' =>
                        $pricing->currency,
                    'effective_date' =>
                        $pricing->effective_date,
                    'expiry_date' =>
                        $pricing->expiry_date,
                ];
            }

            // Manual rate overrides database pricing.
            if (
                array_key_exists('rate', $billing)
                && $billing['rate'] !== null
            ) {
                $rate = (float) $billing['rate'];
            }

            if ($rate === null) {
                $rate = 0;
            }

            $isBillingDraft = $rate <= 0;

            $chargeable = $rateType === 'KG'
                ? $finalWeight
                : max($finalCbm, $minimumCbm);

            $shippingCost = round(
                $chargeable * $rate,
                2
            );

            // 9. Fees.
            $deliveryFee = array_key_exists(
                'delivery_fee',
                $billing
            )
                ? (float) $billing['delivery_fee']
                : (float) (
                    $package->delivery_fee ?? 0
                );

            $handlingFee = array_key_exists(
                'handling_fee',
                $billing
            )
                ? (float) $billing['handling_fee']
                : (float) (
                    $package->handling_fee ?? 0
                );

            $warehouseFee = array_key_exists(
                'warehouse_fee',
                $billing
            )
                ? (float) $billing['warehouse_fee']
                : (float) (
                    $package->warehouse_fee ?? 0
                );

            $otherFee = array_key_exists(
                'other_fee',
                $billing
            )
                ? (float) $billing['other_fee']
                : (float) (
                    $package->other_fee ?? 0
                );

            $discount = array_key_exists(
                'discount',
                $billing
            )
                ? (float) $billing['discount']
                : (float) (
                    $package->discount ?? 0
                );

            $subtotal =
                $deliveryFee
                + $handlingFee
                + $warehouseFee;

            $discount = min(
                $subtotal + $shippingCost + $otherFee,
                $discount
            );

            $grandTotal = round(
                max(
                    0,
                    $subtotal
                    + $shippingCost
                    + $otherFee
                    - $discount
                ),
                2
            );

            // 10. Update pricing snapshot.
            if (is_array($pricingSnapshot)) {
                $pricingSnapshot['pricing_type'] =
                    $pricingType;

                $pricingSnapshot['rate'] = $rate;
                $pricingSnapshot['rate_type'] = $rateType;
                $pricingSnapshot['chargeable'] =
                    $chargeable;

                $pricingSnapshot['final_cbm'] =
                    $finalCbm;

                $pricingSnapshot['final_weight'] =
                    $finalWeight;

                $pricingSnapshot['shipping_cost'] =
                    $shippingCost;

                $pricingSnapshot['rate_source'] =
                    $isBillingDraft
                        ? 'Manual current rate required'
                        : (
                            $pricing
                                ? 'Pricing List / override'
                                : 'Manual current rate'
                        );
            } else {
                $pricingSnapshot = [
                    'pricing_id' => $pricingId,
                    'rate_name' => null,
                    'shipping_mode' => $shippingMode,
                    'pricing_type' => $pricingType,
                    'origin' => $origin,
                    'destination' => $destination,
                    'rate_type' => $rateType,
                    'rate' => $rate,
                    'minimum_cbm' => $minimumCbm,
                    'chargeable' => $chargeable,
                    'final_cbm' => $finalCbm,
                    'final_weight' => $finalWeight,
                    'shipping_cost' => $shippingCost,
                    'currency' => 'USD',
                    'effective_date' => null,
                    'expiry_date' => null,
                    'rate_source' =>
                        $isBillingDraft
                            ? 'Manual current rate required'
                            : 'Manual current rate',
                ];
            }

            // 11. Update package billing snapshot.
            $package->total_cbm = $finalCbm;
            $package->total_weight = $finalWeight;
            $package->pricing_type = $pricingType;
            $package->pricing_id = $pricingId;
            $package->pricing_rate_type = $rateType;
            $package->shipping_rate = $rate;
            $package->shipping_cost = $shippingCost;
            $package->delivery_fee = $deliveryFee;
            $package->handling_fee = $handlingFee;
            $package->warehouse_fee = $warehouseFee;
            $package->other_fee = $otherFee;
            $package->discount = $discount;
            $package->grand_total = $grandTotal;

            if (
                !$isBillingDraft
                && in_array(
                    (string) $package->status,
                    [
                        'Measurement Completed',
                        'Ready for Billing',
                        'Cambodia Warehouse',
                    ],
                    true
                )
            ) {
                $package->status = 'Invoiced';
            }

            $package->save();

            if (
                !$isBillingDraft
                && $package->status === 'Invoiced'
            ) {
                TrackingEvent::create([
                    'tracking_number' =>
                        $package->tracking_number,
                    'package_id' => $package->id,
                    'status' => 'Invoiced',
                    'location' =>
                        $package->warehouse_location
                        ?: 'Cambodia Warehouse',
                    'warehouse' =>
                        'Cambodia Warehouse',
                    'staff_name' =>
                        auth()->user()?->name ?? 'Billing',
                    'note' =>
                        'Billing rate confirmed and invoice issued',
                    'event_at' => now(),
                ]);
            }

            // 12. Build shipping item.
            $boxCount = (int) (
                $package->box_count ?? 0
            );

            $itemQuantity = (int) (
                $package->quantity ?? 0
            );

            $quantity = max(
                1,
                $boxCount > 0
                    ? $boxCount
                    : $itemQuantity
            );

            $items = [
                [
                    'type' => 'shipping',
                    'package_id' => $package->id,
                    'package_number' =>
                        $package->package_id,
                    'description' => trim(
                        (string) (
                            $package->product_name
                            ?: $package->product_category
                            ?: 'Logistics Service'
                        )
                    ),
                    'tracking_number' =>
                        $package->tracking_number,
                    'china_waybill_number' =>
                        $package->china_waybill_number
                        ?: $package->tracking_number,
                    'hfl_package_code' =>
                        $package->hfl_package_code,
                    'quantity' => $quantity,
                    'cbm' => $finalCbm,
                    'weight' => $finalWeight,
                    'unit_price' => $rate,
                    'amount' =>
                        round($shippingCost, 2),
                ],
            ];

            if ($deliveryFee > 0) {
                $items[] = $this->feeItem(
                    $package,
                    'Delivery Fee',
                    $deliveryFee,
                    $finalCbm,
                    $finalWeight
                );
            }

            if ($handlingFee > 0) {
                $items[] = $this->feeItem(
                    $package,
                    'Handling Fee',
                    $handlingFee,
                    $finalCbm,
                    $finalWeight
                );
            }

            if ($warehouseFee > 0) {
                $items[] = $this->feeItem(
                    $package,
                    'Warehouse Fee',
                    $warehouseFee,
                    $finalCbm,
                    $finalWeight
                );
            }

            if ($otherFee > 0) {
                $items[] = $this->feeItem(
                    $package,
                    'Other Fee',
                    $otherFee,
                    $finalCbm,
                    $finalWeight
                );
            }

            // 13. Build invoice metadata.
            $meta = [
                'bill_date' => now()->toDateString(),
                'customer_phone' =>
                    $customer?->phone,
                'customer_address' =>
                    $customer?->address,
                'origin' =>
                    $shipment?->origin
                    ?: $package->from_warehouse,
                'destination' =>
                    $shipment?->destination
                    ?: $package->to_warehouse,
                'shipping_method' =>
                    $shipment?->shipping_mode
                    ?: $package->shipping_mode,
                'tracking_number' =>
                    $package->tracking_number,
                'china_waybill_number' =>
                    $package->china_waybill_number
                    ?: $package->tracking_number,
                'hfl_package_code' =>
                    $package->hfl_package_code,
                'package_id' =>
                    $package->package_id,
                'shipment_number' =>
                    $shipment?->shipment_number,
                'container_number' =>
                    $container?->container_number,
                'final_cbm' => $finalCbm,
                'final_weight' => $finalWeight,
                'pricing_type' => $pricingType,
                'rate' => $rate,
                'rate_type' => $rateType,
                'shipping_cost' => $shippingCost,
                'delivery_fee' => $deliveryFee,
                'handling_fee' => $handlingFee,
                'warehouse_fee' => $warehouseFee,
                'other_fee' => $otherFee,
                'discount' => $discount,
                'payment_method' => null,
                'payment_date' => null,
                'payment_reference' => null,
            ];

            // 14. Create invoice.
            $invoice = new Invoice();

            $invoice->invoice_no =
                'TMP-INV-' . Str::uuid();

            $invoice->quotation_id = null;

            $invoice->customer_id =
                $package->customer_id;

            $invoice->customer_name =
                $package->customer_name
                ?: $customer?->full_name;

            $invoice->status =
                $isBillingDraft
                    ? 'Draft'
                    : 'Unpaid';

            $invoice->items = $items;

            $invoice->pricing_snapshot =
                $pricingSnapshot;

            $invoice->meta = $meta;
            $invoice->subtotal = round($subtotal, 2);
            $invoice->discount = round($discount, 2);
            $invoice->tax = 0;
            $invoice->grand_total = round(
                $grandTotal,
                2
            );
            $invoice->paid_amount = 0;

            $invoice->outstanding =
                $isBillingDraft
                    ? 0
                    : round($grandTotal, 2);

            $invoice->due_date =
                $billing['due_date']
                ?? now()->addDays(7)->toDateString();

            $invoice->save();

            $invoice->invoice_no =
                $this->finalizeInvoiceNumber(
                    $invoice->id
                );

            $invoice->save();

            // 15. Finalize package status.
            $invoiceCanSetInvoicedStatus =
                !$isBillingDraft
                && in_array(
                    (string) $package->status,
                    [
                        'Measurement Completed',
                        'Ready for Billing',
                        'Cambodia Warehouse',
                    ],
                    true
                );

            if ($invoiceCanSetInvoicedStatus) {
                $package->status = 'Invoiced';
                $package->save();

                TrackingEvent::create([
                    'tracking_number' =>
                        $package->tracking_number,
                    'package_id' => $package->id,
                    'status' => 'Invoiced',
                    'location' =>
                        $package->warehouse_location
                        ?: 'Cambodia Warehouse',
                    'warehouse' =>
                        'Cambodia Warehouse',
                    'staff_name' =>
                        auth()->user()?->name ?? 'Billing',
                    'note' =>
                        'Billing rate confirmed and invoice issued',
                    'event_at' => now(),
                ]);
            }

            $invoice->setAttribute(
                'payments',
                collect()
            );

            return $this->ok(
                $invoice,
                'Invoice generated from package successfully.'
            );
        });
    }

    // --------------------------------------------------------
    // GENERATE COMBINED INVOICE
    // --------------------------------------------------------

    public function fromPackages(Request $request)
    {
        $data = $request->validate([
            'package_ids' =>
                'required|array|min:2|max:50',
            'package_ids.*' => 'required',
            'delivery_fee' =>
                'nullable|numeric|min:0',
            'handling_fee' =>
                'nullable|numeric|min:0',
            'warehouse_fee' =>
                'nullable|numeric|min:0',
            'other_fee' =>
                'nullable|numeric|min:0',
            'discount' =>
                'nullable|numeric|min:0',
            'due_date' => 'nullable|date',
        ]);

        $ids = array_values(
            array_unique(
                array_map(
                    'strval',
                    $data['package_ids']
                )
            )
        );

        if (count($ids) < 2) {
            return $this->fail(
                'Select at least 2 different packages '
                . 'for a combined bill.',
                [],
                422
            );
        }

        DB::beginTransaction();

        try {
            $created = [];

            foreach ($ids as $index => $packageId) {
                $payload = array_filter(
                    [
                        'due_date' =>
                            $data['due_date'] ?? null,
                    ],
                    fn ($value) => $value !== null
                );

                foreach ([
                    'delivery_fee',
                    'handling_fee',
                    'warehouse_fee',
                    'other_fee',
                    'discount',
                ] as $field) {
                    if ($index === 0) {
                        if (
                            array_key_exists($field, $data)
                            && $data[$field] !== null
                        ) {
                            $payload[$field] =
                                $data[$field];
                        }
                    } else {
                        $payload[$field] = 0;
                    }
                }

                $sub = Request::create(
                    '/',
                    'POST',
                    $payload
                );

                $sub->setUserResolver(
                    $request->getUserResolver()
                );

                $response = $this->fromPackage(
                    $sub,
                    $packageId
                );

                $body = json_decode(
                    $response->getContent(),
                    true
                ) ?: [];

                if (
                    $response->getStatusCode() >= 400
                    || empty($body['success'])
                ) {
                    DB::rollBack();

                    return $this->fail(
                        'Package ' . $packageId . ': '
                        . (
                            $body['message']
                            ?? 'cannot be billed.'
                        ),
                        $body['errors'] ?? [],
                        422
                    );
                }

                if (
                    ($body['message'] ?? '')
                    !== 'Invoice generated from package successfully.'
                ) {
                    DB::rollBack();

                    return $this->fail(
                        'Package ' . $packageId
                        . ' already has an invoice. '
                        . 'Remove it from the selection.',
                        [],
                        422
                    );
                }

                $invoice = Invoice::where(
                    'is_test',
                    false
                )->findOrFail(
                    $body['data']['id']
                );

                if ((string) $invoice->status === 'Draft') {
                    DB::rollBack();

                    return $this->fail(
                        'Package ' . $packageId
                        . ' has no active pricing rate (Draft). '
                        . 'Set the rate first, then combine.',
                        [],
                        422
                    );
                }

                if (
                    $created
                    && (string) $invoice->customer_id
                    !== (string) $created[0]->customer_id
                ) {
                    DB::rollBack();

                    return $this->fail(
                        'All packages in a combined bill '
                        . 'must belong to the same customer.',
                        [],
                        422
                    );
                }

                $created[] = $invoice;
            }

            $primary = $created[0];

            $items = is_array($primary->items)
                ? $primary->items
                : [];

            $breakdown = [];
            $subtotal = 0.0;
            $discount = 0.0;
            $grand = 0.0;

            foreach ($created as $index => $invoice) {
                $meta = is_array($invoice->meta)
                    ? $invoice->meta
                    : [];

                $breakdown[] = [
                    'package_id' =>
                        collect($invoice->items)
                            ->pluck('package_id')
                            ->filter()
                            ->first(),
                    'tracking_number' =>
                        collect($invoice->items)
                            ->pluck('tracking_number')
                            ->filter()
                            ->first(),
                    'final_cbm' =>
                        $meta['final_cbm'] ?? null,
                    'pricing_type' =>
                        $meta['pricing_type'] ?? null,
                    'rate' =>
                        $meta['rate'] ?? null,
                    'shipping_cost' =>
                        $meta['shipping_cost'] ?? null,
                ];

                $subtotal += (float) (
                    $invoice->subtotal ?? 0
                );

                $discount += (float) (
                    $invoice->discount ?? 0
                );

                $grand += (float) (
                    $invoice->grand_total ?? 0
                );

                if ($index > 0) {
                    foreach (
                        (
                            is_array($invoice->items)
                                ? $invoice->items
                                : []
                        ) as $item
                    ) {
                        $items[] = $item;
                    }
                }
            }

            // Preserve current combined billing behavior.
            foreach (
                array_slice($created, 1)
                as $extra
            ) {
                $extra->delete();
            }

            $meta = is_array($primary->meta)
                ? $primary->meta
                : [];

            $meta['combined'] = true;

            $meta['package_ids'] = collect($items)
                ->pluck('package_id')
                ->filter()
                ->unique()
                ->values()
                ->all();

            $meta['packages'] = $breakdown;

            $meta['shipping_cost'] = round(
                collect($breakdown)->sum(
                    fn ($row) =>
                        (float) (
                            $row['shipping_cost'] ?? 0
                        )
                ),
                2
            );

            $primary->items = $items;
            $primary->meta = $meta;
            $primary->subtotal = round($subtotal, 2);
            $primary->discount = round($discount, 2);
            $primary->grand_total = round($grand, 2);
            $primary->outstanding = round($grand, 2);
            $primary->save();

            DB::commit();

            $primary->setAttribute(
                'payments',
                collect()
            );

            return $this->ok(
                $primary,
                'Combined invoice generated for '
                . count($created)
                . ' packages.'
            );
        } catch (\Throwable $e) {
            DB::rollBack();

            throw $e;
        }
    }

    // --------------------------------------------------------
    // HELPER: FEE ITEM
    // --------------------------------------------------------

    private function feeItem(
        Package $package,
        string $description,
        float $amount,
        float $finalCbm = 0,
        float $finalWeight = 0
    ): array {
        return [
            'type' => 'fee',
            'package_id' => $package->id,
            'package_number' => $package->package_id,
            'description' => $description,
            'tracking_number' =>
                $package->tracking_number,
            'china_waybill_number' =>
                $package->china_waybill_number
                ?: $package->tracking_number,
            'hfl_package_code' =>
                $package->hfl_package_code,
            'quantity' => 1,
            'cbm' => $finalCbm,
            'weight' => $finalWeight,
            'unit_price' => round($amount, 2),
            'amount' => round($amount, 2),
        ];
    }

    // --------------------------------------------------------
    // HELPER: INVOICE NUMBER
    // --------------------------------------------------------

    private function finalizeInvoiceNumber(int $id): string
    {
        $date = now()->format('Ymd');

        $prefix = 'HFL-INV-' . $date . '-';

        return $prefix . str_pad(
            (string) $id,
            6,
            '0',
            STR_PAD_LEFT
        );
    }
