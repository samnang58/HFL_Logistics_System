<?php

namespace App\Http\Controllers;

use App\Models\Customer;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Hash;

class CustomerAuthController extends ApiController
{
    public function login(Request $request)
    {
        $data = $request->validate([
            'username' => 'required|string',
            'password' => 'required|string',
        ]);

        $customer = Customer::where('username', $data['username'])
            ->orWhere('customer_id', $data['username'])
            ->first();

        if (!$customer || empty($customer->password)) {
            return $this->fail('Invalid credentials', [], 401);
        }

        if (!Hash::check($data['password'], $customer->password)) {
            return $this->fail('Invalid credentials', [], 401);
        }

        $token = $customer->createToken('hfl-customer')->plainTextToken;

        return $this->ok([
            'token' => $token,
            'customer' => $customer,
        ], 'Customer login successful');
    }

    public function me(Request $request)
    {
        return $this->ok($request->user());
    }

    public function logout(Request $request)
    {
        $request->user()?->currentAccessToken()?->delete();

        return $this->ok(null, 'Logged out');
    }
}
