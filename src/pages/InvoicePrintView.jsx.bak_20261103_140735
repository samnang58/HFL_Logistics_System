
import React, { useEffect, useMemo, useState } from 'react';
import { ArrowLeft, Printer, RefreshCw } from 'lucide-react';
import { useNavigate, useParams } from 'react-router-dom';

import { getInvoice } from '../services/billingApi.js';
import apiClient from '../api/apiClient.js';

import './invoice-print.css';

// ============================================================
// HELPERS
// ============================================================

const num = value => Number(value || 0);

const money = value => `$${num(value).toFixed(2)}`;

const decimal = (value, digits = 3) =>
  num(value).toFixed(digits);

const text = value =>
  value === null || value === undefined || value === ''
    ? '—'
    : String(value);

const unwrap = response =>
  response?.data?.data ??
  response?.data ??
  response ??
  {};

// Preserve calendar dates without UTC timezone shifting.
function printDate(value) {
  if (!value) return '—';

  const match = String(value).match(
    /^(\d{4})-(\d{2})-(\d{2})/
  );

  if (match) {
    return `${match[3]}/${match[2]}/${match[1]}`;
  }

  const date = new Date(value);

  return Number.isNaN(date.getTime())
    ? '—'
    : date.toLocaleDateString('en-GB');
}

// ============================================================
// SHIPPING MODE
// ============================================================

function ShippingOption({
  active,
  title,
  subtitle,
  badge,
}) {
  return (
    <div
      className={`hfl-mode-line ${
        active ? 'is-active' : ''
      }`}
    >
      <span
        className={`hfl-mode-mark ${
          active ? 'is-active' : ''
        }`}
      >
        {active ? '✓' : ''}
      </span>

      <span>
        {title} <small>{subtitle}</small>
      </span>

      {active && badge && (
        <strong className="hfl-mode-badge">
          {badge}
        </strong>
      )}
    </div>
  );
}

// ============================================================
// INVOICE PRINT PAGE
// ============================================================

export default function InvoicePrintView() {
  const { id } = useParams();
  const navigate = useNavigate();

  const [invoice, setInvoice] = useState(null);
  const [settings, setSettings] = useState({});
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [refreshKey, setRefreshKey] = useState(0);

  useEffect(() => {
    let active = true;

    async function load() {
      setLoading(true);
      setError('');

      // Staff may lack billing.settings permission.
      // The invoice should still load and be printable.
      const [invoiceResult, settingsResult] =
        await Promise.allSettled([
          getInvoice(id),
          apiClient.get('/billing/settings'),
        ]);

      if (!active) return;

      if (invoiceResult.status === 'rejected') {
        setError(
          invoiceResult.reason?.message ||
          'Unable to load invoice.'
        );

        setInvoice(null);
      } else {
        setInvoice(unwrap(invoiceResult.value));

        setSettings(
          settingsResult.status === 'fulfilled'
            ? unwrap(settingsResult.value)
            : {}
        );
      }

      setLoading(false);
    }

    load();

    return () => {
      active = false;
    };
  }, [id, refreshKey]);

  const items = useMemo(
    () => (
      Array.isArray(invoice?.items)
        ? invoice.items
        : []
    ),
    [invoice]
  );

  const meta =
    invoice?.meta &&
    typeof invoice.meta === 'object'
      ? invoice.meta
      : {};

  // Product/shipping lines in the main table.
  const shippingRows = items.filter(
    row =>
      String(row?.type || '').toLowerCase() !== 'fee'
  );

  // Additional charges appear in the bottom-right area.
  const feeRows = items.filter(
    row =>
      String(row?.type || '').toLowerCase() === 'fee'
  );

  const fallbackFees = [
    ['Delivery Fee / 本地配送', meta.delivery_fee],
    ['Handling Fee / 搬运费', meta.handling_fee],
    ['Warehouse Fee / 仓储费', meta.warehouse_fee],
    ['Other Fee / 其他费用', meta.other_fee],
  ]
    .filter(([, amount]) => num(amount) > 0)
    .map(([description, amount]) => ({
      description,
      amount,
    }));

  const fees = feeRows.length
    ? feeRows
    : fallbackFees;

  const invoiceNo = text(
    invoice?.invoice_no ??
    invoice?.invoiceNo
  );

  const grandTotal = num(
    invoice?.grand_total ??
    invoice?.grandTotal
  );

  const discount = num(invoice?.discount);
  const tax = num(invoice?.tax);

  const status = String(
    invoice?.status || ''
  ).toLowerCase();

  const isVoided = [
    'void',
    'voided',
    'cancelled',
  ].includes(status);

  const isDraft = status === 'draft';

  const canPrint =
    !loading &&
    !error &&
    invoice &&
    !isVoided &&
    !isDraft;

  // Determine shipping mode from actual invoice data.
  const rawMode = String(
    meta.shipping_method ||
    meta.shipping_mode ||
    invoice?.pricing_snapshot?.shipping_mode ||
    ''
  ).toUpperCase();

  const mode =
    /LAND|ROAD|TRUCK/.test(rawMode)
      ? 'LAND'
      : /SEA|OCEAN/.test(rawMode)
        ? 'SEA'
        : /AIR/.test(rawMode)
          ? 'AIR'
          : 'OTHER';

  const pricingType = String(
    meta.pricing_type ||
    invoice?.pricing_snapshot?.pricing_type ||
    ''
  ).toUpperCase();

  const origin = text(meta.origin);
  const destination = text(meta.destination);

  const date = printDate(
    meta.bill_date ||
    invoice?.invoice_date ||
    invoice?.created_at
  );

  const container = text(
    meta.container_number ||
    shippingRows.find(
      row => row.container_number
    )?.container_number
  );

  // Show at least 3 rows like the sample invoice.
  const rowsToShow = Math.max(
    3,
    shippingRows.length
  );

  const gridRows = Array.from(
    { length: rowsToShow },
    (_, i) => shippingRows[i] || null
  );

  // Bank values are loaded from Laravel billing settings.
  const bankAccount =
    settings.khr_account ||
    settings.aba_account ||
    '';

  const bankName =
    settings.account_name ||
    '';

  // ----------------------------------------------------------
  // LOADING / ERROR
  // ----------------------------------------------------------

  if (loading) {
    return (
      <div className="hfl-print-message">
        Loading invoice...
      </div>
    );
  }

  if (error || !invoice) {
    return (
      <div className="hfl-print-message hfl-print-error">
        {error || 'Invoice not found.'}
      </div>
    );
  }

  // ==========================================================
  // RENDER INVOICE
  // ==========================================================

  return (
    <div className="hfl-print-root">
      {/* PRINT TOOLBAR — hidden on paper */}
      <div className="hfl-print-toolbar">
        <button
          type="button"
          onClick={() => navigate(-1)}
        >
          <ArrowLeft size={16} />
          Back
        </button>

        <button
          type="button"
          onClick={() =>
            setRefreshKey(value => value + 1)
          }
        >
          <RefreshCw size={16} />
          Refresh
        </button>

        <button
          type="button"
          className="primary"
          onClick={() => window.print()}
          disabled={!canPrint}
        >
          <Printer size={16} />

          {isVoided
            ? 'Voided Invoice'
            : isDraft
              ? 'Confirm Rate First'
              : 'Print Invoice'}
        </button>
      </div>

      {/* PRINTABLE PAPER */}
      <main className="hfl-print-sheet">
        {/* ============================================= */}
        {/* COMPANY HEADER                                */}
        {/* ============================================= */}

        <header className="hfl-print-header">
          {/* LOGO */}
          <div className="hfl-print-logo">
            <img
              src={`${import.meta.env.BASE_URL}img/profile.jpg`}
              alt="HFL Logistics logo"
            />

            <strong>
              HIGH FAST LOGISTICS
            </strong>

            <small>
              海发国际物流
            </small>
          </div>

          {/* COMPANY NAME */}
          <div className="hfl-print-company">
            <div className="kh">
              ក្រុមហ៊ុនដឹកជញ្ជូនពីចិនមកខ្មែរ
            </div>

            <div className="en">
              HFL LOGISTICS CO., LTD.
            </div>

            <div className="zh">
              海发物流有限公司
            </div>
          </div>

          {/* INVOICE TITLE */}
          <div className="hfl-print-heading">
            <span>វិក្កយបត្រ</span>
            <span>发票</span>
            <strong>INVOICE</strong>
          </div>
        </header>

        {/* ============================================= */}
        {/* CUSTOMER + SHIPPING + BANK                    */}
        {/* ============================================= */}

        <div className="hfl-print-top">
          {/* CUSTOMER INFORMATION */}
          <div className="hfl-customer-box">
            <div>
              <span>Customer Name:</span>

              <strong>
                {text(
                  invoice.customer_name ??
                  invoice.customerName
                )}
              </strong>
            </div>

            <div>
              <span>Customer ID:</span>

              <strong className="blue">
                {text(
                  invoice.customer_id ??
                  invoice.customerId
                )}
              </strong>
            </div>

            <div>
              <span>Container No:</span>

              <strong className="hfl-chip">
                {container}
              </strong>
            </div>

            <div>
              <span>Route Corridor:</span>

              <strong className="blue">
                {origin} → {destination}
              </strong>
            </div>

            <div>
              <span>Invoice Date:</span>

              <strong>{date}</strong>
            </div>
          </div>

          {/* SHIPPING MODE */}
          <div className="hfl-mode-box">
            <div className="hfl-mode-title">
              SHIPPING MODE / ដឹកជញ្ជូន / 运输方式
            </div>

            <ShippingOption
              active={mode === 'LAND'}
              title="Land"
              subtitle="/ 直邮 (ផ្លូវគោក)"
              badge={pricingType}
            />

            <ShippingOption
              active={mode === 'SEA'}
              title="Sea"
              subtitle="/ 海运 (ផ្លូវទឹក)"
              badge={pricingType}
            />

            <ShippingOption
              active={mode === 'AIR'}
              title="Air"
              subtitle="/ 空运 (ផ្លូវអាកាស)"
              badge={pricingType}
            />

            <ShippingOption
              active={mode === 'OTHER'}
              title="Other"
              subtitle="/ 其他"
              badge={pricingType}
            />
          </div>

          {/* INVOICE NUMBER / ABA */}
          <div className="hfl-bank-box">
            <div className="hfl-invoice-label">
              INVOICE NUMBER:
            </div>

            <strong className="hfl-invoice-number">
              {invoiceNo}
            </strong>

            <div className="hfl-bank-title">
              ▣ ABA Bank (KHR)
            </div>

            <div className="hfl-bank-row">
              <div className="hfl-bank-details">
                <span>A/C Number:</span>

                <strong className="hfl-account-number">
                  {bankAccount || '—'}
                </strong>

                <span>Account Name:</span>

                <strong className="hfl-account-name">
                  {bankName || '—'}
                </strong>
              </div>

            </div>
          </div>
        </div>

        {/* ============================================= */}
        {/* SHIPPING ITEM TABLE                           */}
        {/* ============================================= */}

        <table className="hfl-products-table">
          <colgroup>
            <col style={{ width: '6%' }} />
            <col style={{ width: '21%' }} />
            <col style={{ width: '23%' }} />
            <col style={{ width: '16%' }} />
            <col style={{ width: '7%' }} />
            <col style={{ width: '8%' }} />
            <col style={{ width: '7%' }} />
            <col style={{ width: '6%' }} />
            <col style={{ width: '6%' }} />
          </colgroup>

          <thead>
            <tr>
              <th>
                ល.រ
                <br />
                NO
              </th>

              <th>
                លេខទំនិញ
                <br />
                Tracking No.
              </th>

              <th>
                លេខកុងតឺន័រ / 运单
                <br />
                China Waybill
              </th>

              <th>
                ឈ្មោះទំនិញ
                <br />
                Description
              </th>

              <th>
                ចំនួន
                <br />
                Qty
              </th>

              <th>
                ទំហំ
                <br />
                CBM
              </th>

              <th>
                ទម្ងន់
                <br />
                KG
              </th>

              <th>
                តម្លៃ
                <br />
                Rate
              </th>

              <th>
                សរុប
                <br />
                Amount
              </th>
            </tr>
          </thead>

          <tbody>
            {gridRows.map((item, i) => (
              <tr
                key={
                  item?.package_id ??
                  `empty-${i}`
                }
              >
                <td>{i + 1}</td>

                <td>
                  {item
                    ? text(
                        item.tracking_number ||
                        item.hfl_package_code ||
                        item.package_number ||
                        meta.tracking_number
                      )
                    : '—'}
                </td>

                <td>
                  {item
                    ? text(
                        item.china_waybill_number ||
                        meta.china_waybill_number
                      )
                    : '—'}
                </td>

                <td className="description">
                  {item
                    ? text(
                        item.product_name ||
                        item.description
                      )
                    : '—'}
                </td>

                <td>
                  {item
                    ? text(item.quantity ?? 1)
                    : '—'}
                </td>

                <td>
                  {item
                    ? decimal(item.cbm, 3)
                    : '—'}
                </td>

                <td>
                  {item
                    ? decimal(item.weight, 2)
                    : '—'}
                </td>

                <td>
                  {item
                    ? money(item.unit_price)
                    : '—'}
                </td>

                <td>
                  {item
                    ? money(item.amount)
                    : '—'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>

        {/* ============================================= */}
        {/* TERMS / EXTRA CHARGES / GRAND TOTAL           */}
        {/* ============================================= */}

        <section className="hfl-bill-bottom">
          {/* TERMS */}
          <div className="hfl-terms">
            <strong>
              ⚒ លក្ខខណ្ឌ / 条款及说明
            </strong>

            <p>
              <b>ចំណាំ៖</b> មុនទទួលទំនិញ សូមពិនិត្យទម្ងន់
              ទំហំ និងតម្លៃឱ្យបានត្រឹមត្រូវ។
              ទំនិញដែលបានចុះហត្ថលេខាទទួលរួច
              ក្រុមហ៊ុនមិនទទួលខុសត្រូវចំពោះការខ្វះខាត
              ដែលមិនបានរាយការណ៍នោះទេ។
            </p>

            <p>
              注意：在收货前，请仔细检查货物的重量、
              体积和价格。签收前应根据发票核对货物信息。
            </p>

            <p>
              ក្រុមហ៊ុនមិនទទួលខុសត្រូវចំពោះទំនិញងាយបែកបាក់
              ឬខូចខាត ដែលមិនបានវេចខ្ចប់ត្រឹមត្រូវ។
            </p>

            <p>
              公司不对包装不当造成的易碎、
              易损货物损坏承担责任。
            </p>
          </div>

          {/* FEES */}
          <div className="hfl-fees">
            <div className="hfl-fee-lines">
              {fees.map((fee, i) => (
                <div
                  key={`${fee.description}-${i}`}
                >
                  <span>
                    {text(fee.description)}
                  </span>

                  <strong>
                    {money(fee.amount)}
                  </strong>
                </div>
              ))}

              {discount > 0 && (
                <div>
                  <span>
                    Discount / 折扣
                  </span>

                  <strong>
                    −{money(discount)}
                  </strong>
                </div>
              )}

              {tax > 0 && (
                <div>
                  <span>
                    Tax / 税
                  </span>

                  <strong>
                    {money(tax)}
                  </strong>
                </div>
              )}

              {!fees.length &&
                discount === 0 &&
                tax === 0 && (
                  <div>
                    <span>
                      Shipping / 运费
                    </span>

                    <strong>
                      {money(
                        invoice.subtotal ??
                        grandTotal
                      )}
                    </strong>
                  </div>
                )}
            </div>

            {/* GRAND TOTAL */}
            <div className="hfl-grand">
              <span>
                សរុបជាប្រាក់ដុល្លារ / 合计
              </span>

              <strong>
                {money(grandTotal)}
              </strong>
            </div>
          </div>
        </section>

        {/* ============================================= */}
        {/* SIGNATURES                                   */}
        {/* ============================================= */}

        <section className="hfl-signatures">
          <div>
            <strong>
              អ្នកចេញវិក្កយបត្រ / 制单人
            </strong>

            <div className="sign-line" />

            <span>
              Date: ____ / ____ / ______
            </span>
          </div>

          <div>
            <strong>
              ហត្ថលេខាអតិថិជន / 客户签收
            </strong>

            <div className="sign-line" />

            <span>
              Date: ____ / ____ / ______
            </span>
          </div>
        </section>

        {/* FOOTER */}
        <footer className="hfl-print-footer">
          វិក្កយបត្រផ្លូវការ HFL Logistics —
          សូមរក្សាទុកសម្រាប់ជាឯកសារយោង
        </footer>
      </main>
    </div>
  );
}
